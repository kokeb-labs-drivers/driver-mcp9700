 * configure_file() writes it here.
 */
#ifndef MCP9700_VERSION_H
#define MCP9700_VERSION_H

/** Major version: incompatible API changes. */
#define MCP9700_VERSION_MAJOR @MCP9700_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define MCP9700_VERSION_MINOR @MCP9700_VERSION_MINOR@
/** Patch version: fixes. */
#define MCP9700_VERSION_PATCH @MCP9700_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define MCP9700_VERSION_STRING "@MCP9700_VERSION@"

#endif // MCP9700_VERSION_H
